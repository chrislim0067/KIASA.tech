# KIASA environment variables.
#
# Copy to .env.local for local development (that filename is git-ignored).
# In production these are set in the Vercel project settings, per environment.
#
# NEVER commit real values. NEVER give a secret a NEXT_PUBLIC_ prefix: Next
# inlines those into the client bundle at build time, so the "secret" would be
# published to every visitor.

# ---------------------------------------------------------------------------
# Public — safe to reach the browser
# ---------------------------------------------------------------------------

# The Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=

# The publishable (anon) key. Designed to be shipped to clients and constrained
# by Row Level Security.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Absolute base URL of this deployment, e.g. https://www.kiasa.tech
# Used server-side to build invitation links. Set it explicitly rather than
# deriving from the request Host, which is attacker-influenceable — an
# invitation email carrying an attacker-chosen link is a phishing message sent
# from KIASA's own domain.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Server-side only — must never reach the browser
# ---------------------------------------------------------------------------

# The Supabase secret (service-role) key.
#
# Required by the administrator surface and nothing else. It bypasses Row Level
# Security entirely and can read and write every user's data, so:
#
#   * it is read in exactly one module, lib/supabase/admin.ts, which begins with
#     `import 'server-only'` — the build FAILS if anything reachable from a
#     Client Component ever imports it;
#   * in Vercel it must be added WITHOUT the NEXT_PUBLIC_ prefix;
#   * rotate it in the Supabase dashboard if it is ever exposed.
#
# With this unset the site runs normally and /admin reports that the
# administrator surface is not configured. Nothing else degrades.
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Notification email (optional)
# ---------------------------------------------------------------------------
# Used to tell a candidate their account was approved or rejected.
#
# BOTH must be set or nothing is sent. When they are unset the decision still
# succeeds and the API answers `emailDelivery: "not_configured"`, which the
# admin UI surfaces as "approved, but no email was sent" — it never claims to
# have notified someone it did not.
#
# From https://resend.com -> API Keys. Server-side only, no NEXT_PUBLIC_ prefix.
RESEND_API_KEY=

# The sender, on a domain verified with the provider. Sending from an
# unverified domain is the usual reason mail silently lands in spam.
#   e.g.  KIASA <noreply@kiasa.tech>
EMAIL_FROM=

# ---------------------------------------------------------------------------
# Résumé import (optional)
# ---------------------------------------------------------------------------
# Reads an uploaded PDF into the candidate schema so the profile does not have
# to be typed from scratch. Everything it finds is shown for review; nothing is
# written until the candidate confirms it.
#
# From https://console.anthropic.com -> API Keys. Server-side only:
#
#   * it is read in exactly one module, lib/resume/extract.ts, which begins with
#     `import 'server-only'`;
#   * in Vercel it must be added WITHOUT the NEXT_PUBLIC_ prefix — a key with
#     that prefix is compiled into the JavaScript every visitor downloads;
#   * résumé import also needs SUPABASE_SECRET_KEY above, because the import
#     record is created server-side.
#
# With this unset /profile/resume says import is not switched on and the profile
# can still be filled in by hand. Nothing else degrades.
ANTHROPIC_API_KEY=
