space:nowrap;\" data-astro-cid-7b6a54ef><label for=\"lp-hp-field\" data-astro-cid-7b6a54ef>Leave this field empty</label><input id=\"lp-hp-field\" type=\"text\" name=\"hp_field\" autocomplete=\"new-password\" tabindex=\"-1\" data-astro-cid-7b6a54ef></div><div class=\"lp-form__grid\" data-astro-cid-7b6a54ef><div class=\"lp-form__field\"><label class=\"lp-form__label\" for=\"fld-company\"> 会社名（任意）  </label><input class=\"lp-form__input\" id=\"fld-company\" name=\"company\" type=\"text\" placeholder value autocomplete=\"organization\"><p class=\"lp-form__error\" data-error-for=\"company\">このフィールドを入力してください。</p></div><div class=\"lp-form__field\"><label class=\"lp-form__label\" for=\"fld-name\"> お名前 <span class=\"lp-form__req\">*</span></label><input class=\"lp-form__input\" id=\"fld-name\" name=\"name\" type=\"text\" placeholder value required autocomplete=\"name\"><p class=\"lp-form__error\" data-error-for=\"name\">このフィールドを入力してください。</p></div><div class=\"lp-form__field\"><label class=\"lp-form__label\" for=\"fld-email\"> メールアドレス <span class=\"lp-form__req\">*</span></label><input class=\"lp-form__input\" id=\"fld-email\" name=\"email\" type=\"email\" placeholder value required autocomplete=\"email\"><p class=\"lp-form__error\" data-error-for=\"email\"></p></div><div class=\"lp-form__field full-width-child\"><label class=\"lp-form__label\" for=\"fld-message\"> どのようなものをつくりたいですか？ <span class=\"lp-form__req\">*</span></label><textarea class=\"lp-form__textarea\" id=\"fld-message\" name=\"message\" placeholder rows=\"5\" required></textarea><p class=\"lp-form__error\" data-error-for=\"message\">このフィールドを入力してください。</p></div></div><div class=\"flx contact-cta-wrapper\" data-astro-cid-7b6a54ef><button class=\"lp-btn lp-btn--primary\" type=\"submit\" data-astro-cid-7b6a54ef><span class=\"btn-text\" data-astro-cid-7b6a54ef>メッセージを送信</span><span class=\"btn-loader\" aria-hidden=\"true\" data-astro-cid-7b6a54ef></span></button><p class=\"lp-contact-bookcall\" data-astro-cid-7b6a54ef>